{
  "name": "@anodb/core",
  "version": "0.7.1",
  "description": "Absolutely No DB — a decentralized, local-first database over Nostr. Zero servers to run. Zero servers to trust.",
  "type": "module",
  "license": "MIT",
  "author": "show-ritz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sho-ritz/anodb.git"
  },
  "keywords": [
    "nostr",
    "local-first",
    "sqlite",
    "crdt",
    "sync",
    "offline",
    "e2ee"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./cli": "./dist/cli/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "PROTOCOL.md",
    "docs/DESIGN.md",
    "docs/DECISIONS.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:public": "npm run build && node examples/public-relay-smoke.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "kysely": "^0.29.8",
    "nostr-p2p": "^0.1.1",
    "nostr-tools": "^2.26.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@types/ws": "^8.18.2",
    "node-datachannel": "^0.33.6",
    "react": "^19.3.1",
    "sql.js": "^1.15.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "ws": "^8.22.2"
  },
  "bin": {
    "anodb": "dist/cli/main.js"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
